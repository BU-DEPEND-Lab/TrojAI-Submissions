Bootstrap: docker
From: pytorch/pytorch:2.2.2-cuda11.8-cudnn8-runtime

%files
    ./detector.py /
    ./entrypoint.py /
    ./utils /
    ./metaparameters.json /
    ./metaparameters_schema.json /
    ./learned_parameters /
    ./scratch /

%post
    apt update

    pip install --upgrade pip
    pip install jsonschema scikit-learn transformers accelerate peft
    
    chmod 755 /*.py
    touch output.txt
    chmod 777 output.txt
    chmod 755 -R /utils
    chmod 755 /*.json
    chmod 755 -R  /learned_parameters
    chmod 777 -R /scratch/

%runscript
    exec python3 /entrypoint.py "$@"
